{
  "name": "clearvault-pwa",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "build:pinyin": "node scripts/build-pinyin-map.mjs",
    "release": "node scripts/release.mjs",
    "pretest": "node scripts/build-public-pages.mjs && node scripts/build-extension.mjs",
    "build:public": "node scripts/build-public-pages.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:release": "node scripts/release.mjs && node scripts/check-release.mjs",
    "build": "npm run release"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "jsqr": "1.4.0",
    "pinyin-pro": "3.29.5",
    "prettier": "3.9.10"
  },
  "version": "0.4.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cool403/clean-vault.git"
  },
  "homepage": "https://clear-vault.app",
  "bugs": {
    "url": "https://github.com/cool403/clean-vault/issues"
  }
}
